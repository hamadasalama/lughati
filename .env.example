# انسخي هذا الملف إلى .env وعدّلي القيم — لا ترفعي .env نفسه
NODE_ENV=development
PORT=4000

# كلمة المرور يجب أن تكون بصيغة URL-safe أو مُرمّزة
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/student_evaluation_db

# سر طويل وعشوائي (32 حرفاً أو أكثر) — لا تستخدمي القيمة التجريبية في الإنتاج
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

CORS_ORIGIN=http://localhost:5173

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=6

# عند التشغيل خلف Nginx/IIS ضعي عدد الوسطاء (غالباً 1)، وإلا اتركيه 0
TRUST_PROXY=0

# فحص الفيروسات الاختياري عبر ClamAV (يُفضّل تفعيله في الإنتاج)
# عند التفعيل: فشل الفحص أو غياب الأداة = رفض الملف (fail-closed)
CLAMAV_ENABLED=false
CLAMAV_BIN=clamdscan
CLAMAV_TIMEOUT_MS=20000

# تُستخدم مرة واحدة عند تنفيذ npm run seed
ADMIN_USERNAME=maha
ADMIN_PASSWORD=CHANGE_ME_TOO

# قاعدة الاختبار المنفصلة (تُفرّغ بالكامل أثناء npm test)
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/student_evaluation_test
